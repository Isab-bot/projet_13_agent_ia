# === API ===
# Port de la machine (hôte) pour accéder à l'API.
# L'API écoute toujours sur le port 8000 dans le conteneur.
# Changer cette valeur si le port 8000 est déjà occupé .
API_PORT=8000

LICHESS_TOKEN=